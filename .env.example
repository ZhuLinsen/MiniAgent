# Interactive setup: miniagent --connect (optional OS vault: miniagent[credentials]).
# Otherwise select a real model explicitly; a key alone never selects one.
LLM_MODEL=
# LLM_MODEL=provider:model-id
# Set the selected provider's credential, e.g. DEEPSEEK_API_KEY or OPENAI_API_KEY.
# ANTHROPIC_API_KEY, DASHSCOPE_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY are supported.
# LLM_API_KEY and LLM_API_BASE are explicit OpenAI-compatible gateway overrides.
# LLM_API_KEY=your-provider-key
# LLM_API_BASE=https://your-gateway.example/v1

# Existing configuration (JSON can override temperature / context_budget).
# LLM_TEMPERATURE=0.7
# Temperature precedence: --temperature > JSON llm.temperature > environment > 0.7.
# Empty environment is unset; only the effective value is validated. JSON null uses the provider default.
# MINIAGENT_CONTEXT_BUDGET=32768
# MINIAGENT_HOME=~/.miniagent
# MINIAGENT_STREAM=1
# LOG_LEVEL=WARNING

# Tool execution limits are environment settings, not JSON agent options.
# BASH_TIMEOUT=120
# BASH_MAX_OUTPUT=50000
# TOOL_RESULT_LIMIT=16000
# Managed tools hide .env*, .git and private-key files by default.
# --allow-sensitive-files explicitly opens managed access; Shell/MCP remain trusted.

# Retired: MAX_CONTEXT_MESSAGES, CONFIRM_DANGEROUS, ENABLE_REFLECTION,
# REFLECTION_MAX_ITERATIONS, LLM_ORGANIZATION and built-in SERPAPI_KEY search.
# Use --policy readonly|confirm|trusted, context_budget and explicit plugins instead.
# Old teaching APIs are available on codex/legacy-pre-harness; see docs/legacy-migration.md.
# Custom endpoint JSON: providers.<name> {type, base_url, api_key_env}.
# Opt-in live tests: MINIAGENT_TEST_MODEL=provider:model-id.
