# ===== Required =====
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek:<model-id>
LLM_API_BASE=https://api.deepseek.com/v1

# ===== Alternative models (uncomment one) =====
# LLM_MODEL=qwen-plus
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM_MODEL=gpt-4o
# LLM_API_BASE=https://api.openai.com/v1

# LLM_MODEL=gemini-2.5-flash
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: set GEMINI_API_KEY instead of LLM_API_KEY

# ===== Optional: Agent behavior =====
# LLM_TEMPERATURE=0.7
# LLM_ORGANIZATION=                # OpenAI organization ID
# BASH_TIMEOUT=120                 # bash tool timeout in seconds
# BASH_MAX_OUTPUT=50000            # max bash output chars
# TOOL_RESULT_LIMIT=16000          # max tool result chars fed to LLM
# MAX_CONTEXT_MESSAGES=20          # auto-compress after this many messages
# MINIAGENT_CONTEXT_BUDGET=32768   # new runtime: conservative budget including tool schemas
# Sensitive files: managed tools hide .env*, .git and private-key files by default.
# Explicit opt-in is --allow-sensitive-files; Shell/MCP remain trusted software.
# CONFIRM_DANGEROUS=true           # confirm rm -rf, sudo, etc.
# MINIAGENT_STREAM=1               # 1=streaming on, 0=off
# MINIAGENT_HOME=~/.miniagent      # Harness sessions/ and legacy memory storage
# MINIAGENT_HOME also stores connections.json (model IDs/URLs/environment names only).
# Interactive setup: miniagent --connect; OS vault support: pip install 'miniagent[credentials]'.
# Without an OS vault, entered keys stay only in the current process; export provider keys for automation.
# LOG_LEVEL=INFO                   # logging level (DEBUG/INFO/WARNING/ERROR)

# ===== Optional: Reflection =====
# ENABLE_REFLECTION=true
# REFLECTION_MAX_ITERATIONS=3

# ===== Optional: Web search =====
# SERPAPI_KEY=your_serpapi_key_here

# ===== Provider isolation =====
# Prefer LLM_MODEL=provider:model-id with that provider's own credential.
# Model selection: CLI --model > JSON llm.model > LLM_MODEL > saved connection default.
# A key or base URL alone never selects a default model. Replace <model-id>.
# OPENAI_API_KEY, DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, DASHSCOPE_API_KEY, etc.
# LLM_API_KEY and LLM_API_BASE are explicit compatibility endpoint overrides.
# Keys from unrelated providers are never searched as a fallback chain.
# MINIAGENT_TEST_MODEL=provider:model-id  # opt-in live smoke test only
# Custom endpoints are configured in JSON: providers.<name> with
# type=openai-compatible, base_url, api_key_env; then LLM_MODEL=<name>:<model-id>.
